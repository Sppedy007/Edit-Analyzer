<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Analyzer Report — {{ result.source_filename }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-dark: #0F1117;
      --bg-card: #181B24;
      --bg-card-hover: #222634;
      --border-color: #2A2E3D;
      --text-main: #F0F3F9;
      --text-muted: #8E96A7;
      --text-dim: #5C6475;
      
      --accent-purple: #8B5CF6;
      --accent-blue: #3B82F6;
      --accent-pink: #EC4899;
      
      --cut-hard: #EF4444;
      --cut-dissolve: #F59E0B;
      --cut-fade: #10B981;
      --cut-unknown: #6B7280;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      font-family: 'Inter', sans-serif;
      line-height: 1.6;
      padding: 2.5rem 1.5rem;
      max-width: 1280px;
      margin: 0 auto;
    }

    /* Header & Navbar */
    header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border-color);
      flex-wrap: wrap;
      gap: 1rem;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .brand-logo {
      width: 42px;
      height: 42px;
      background: linear-gradient(135deg, var(--accent-purple), var(--accent-pink));
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Outfit', sans-serif;
      font-weight: 700;
      font-size: 1.25rem;
      color: white;
      box-shadow: 0 4px 14px rgba(139, 92, 246, 0.4);
    }

    .brand-title h1 {
      font-family: 'Outfit', sans-serif;
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .brand-title p {
      font-size: 0.875rem;
      color: var(--text-muted);
    }

    .meta-pills {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .meta-pill {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      padding: 0.4rem 0.85rem;
      border-radius: 8px;
      font-size: 0.825rem;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .meta-pill strong {
      color: var(--text-main);
    }

    /* Section Cards */
    .section-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    @media (max-width: 900px) {
      .section-grid {
        grid-template-columns: 1fr;
      }
    }

    .card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 1.5rem;
      box-shadow: 0 8px 24px rgba(0,0,0,0.2);
    }

    .card-title {
      font-family: 'Outfit', sans-serif;
      font-size: 1.1rem;
      font-weight: 600;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--text-main);
    }

    .card-title-icon {
      color: var(--accent-purple);
    }

    .summary-text {
      color: var(--text-muted);
      font-size: 0.95rem;
      line-height: 1.7;
    }

    /* Timeline Bar */
    .timeline-container {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 1.5rem;
      margin-bottom: 2rem;
    }

    .timeline-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }

    .legend {
      display: flex;
      gap: 1rem;
      font-size: 0.8rem;
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      color: var(--text-muted);
    }

    .legend-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }

    .legend-dot.hard { background-color: var(--cut-hard); }
    .legend-dot.dissolve { background-color: var(--cut-dissolve); }
    .legend-dot.fade { background-color: var(--cut-fade); }
    .legend-dot.unknown { background-color: var(--cut-unknown); }

    .timeline-bar-wrapper {
      position: relative;
      height: 48px;
      background: #11131C;
      border-radius: 10px;
      display: flex;
      overflow: hidden;
      border: 1px solid var(--border-color);
    }

    .timeline-segment {
      height: 100%;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      border-right: 2px solid rgba(0,0,0,0.6);
      transition: opacity 0.2s;
      cursor: pointer;
    }

    .timeline-segment:hover {
      opacity: 0.85;
    }

    .timeline-segment-label {
      font-size: 0.75rem;
      font-weight: 600;
      color: rgba(255,255,255,0.9);
      text-shadow: 0 1px 3px rgba(0,0,0,0.8);
      font-family: 'JetBrains Mono', monospace;
    }    .motion-flags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-top: 0.75rem;
    }

    .motion-badge {
      font-size: 0.7rem;
      font-weight: 500;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      line-height: 1.3;
    }

    .motion-badge.ramp {
      background-color: rgba(59, 130, 246, 0.2);
      color: #93C5FD;
      border: 1px solid rgba(59, 130, 246, 0.4);
    }

    .motion-badge.roto {
      background-color: rgba(236, 72, 153, 0.2);
      color: #FBCFE8;
      border: 1px solid rgba(236, 72, 153, 0.4);
    }

    .motion-badge.seam {
      background-color: rgba(168, 85, 247, 0.2);
      color: #E9D5FF;
      border: 1px solid rgba(168, 85, 247, 0.4);
    }

    /* Shot Grid */
    .shots-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.25rem;
      margin-bottom: 2.5rem;
    }

    .shot-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 14px;
      padding: 1.25rem;
      transition: transform 0.2s, border-color 0.2s;
    }

    .shot-card:hover {
      transform: translateY(-2px);
      border-color: rgba(139, 92, 246, 0.4);
    }

    .shot-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.75rem;
    }

    .shot-number {
      font-family: 'Outfit', sans-serif;
      font-weight: 700;
      font-size: 1rem;
      color: var(--text-main);
    }

    .cut-badge {
      font-size: 0.725rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 0.25rem 0.6rem;
      border-radius: 6px;
      color: white;
    }

    .cut-badge.hard { background-color: rgba(239, 68, 68, 0.2); color: #FCA5A5; border: 1px solid rgba(239, 68, 68, 0.4); }
    .cut-badge.dissolve { background-color: rgba(245, 158, 11, 0.2); color: #FDE68A; border: 1px solid rgba(245, 158, 11, 0.4); }
    .cut-badge.fade { background-color: rgba(16, 185, 129, 0.2); color: #6EE7B7; border: 1px solid rgba(16, 185, 129, 0.4); }
    .cut-badge.unknown { background-color: rgba(107, 114, 128, 0.2); color: #D1D5DB; border: 1px solid rgba(107, 114, 128, 0.4); }

    .shot-time {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.825rem;
      color: var(--text-muted);
      margin-bottom: 1rem;
    }

    .palette-swatches {
      display: flex;
      height: 36px;
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid rgba(255,255,255,0.08);
    }

    .swatch {
      flex: 1;
      height: 100%;
      position: relative;
      transition: flex 0.2s;
    }

    .swatch:hover {
      flex: 1.8;
    }

    /* Transcript Section */
    .transcript-container {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 1.5rem;
    }

    .transcript-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      max-height: 400px;
      overflow-y: auto;
      padding-right: 0.5rem;
    }

    .transcript-item {
      display: flex;
      gap: 1rem;
      padding: 0.75rem 1rem;
      background: #12141D;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,0.03);
    }

    .transcript-time {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.8rem;
      color: var(--accent-purple);
      font-weight: 500;
      white-space: nowrap;
      padding-top: 0.1rem;
    }

    .transcript-text {
      font-size: 0.925rem;
      color: var(--text-main);
    }

    footer {
      text-align: center;
      margin-top: 3rem;
      color: var(--text-dim);
      font-size: 0.8rem;
    }
  </style>
</head>
<body>

  <header>
    <div class="brand">
      <div class="brand-logo">EA</div>
      <div class="brand-title">
        <h1>Edit Analyzer</h1>
        <p>Video Edit Breakdown & Research Report</p>
      </div>
    </div>
    <div class="meta-pills">
      <div class="meta-pill">File: <strong>{{ result.source_filename }}</strong></div>
      <div class="meta-pill">Duration: <strong>{{ "%.1f"|format(result.duration_seconds) }}s</strong></div>
      <div class="meta-pill">Shots: <strong>{{ result.shots|length }}</strong></div>
      <div class="meta-pill">Job ID: <strong>{{ result.job_id }}</strong></div>
    </div>
  </header>

  <!-- Summaries Grid -->
  <div class="section-grid">
    <div class="card">
      <div class="card-title">
        <span class="card-title-icon">💬</span> Topic Summary
      </div>
      <p class="summary-text">{{ result.topic_summary }}</p>
    </div>
    <div class="card">
      <div class="card-title">
        <span class="card-title-icon">🎬</span> Edit Style & Pacing Summary
      </div>
      <p class="summary-text">{{ result.style_summary }}</p>
    </div>
  </div>

  <!-- Timeline Bar -->
  <div class="timeline-container">
    <div class="timeline-header">
      <div class="card-title" style="margin-bottom: 0;">
        <span class="card-title-icon">⏱</span> Visual Cut Timeline
      </div>
      <div class="legend">
        <div class="legend-item"><div class="legend-dot hard"></div> Hard Cut</div>
        <div class="legend-item"><div class="legend-dot dissolve"></div> Dissolve</div>
        <div class="legend-item"><div class="legend-dot fade"></div> Fade</div>
        <div class="legend-item"><div class="legend-dot unknown"></div> Unknown</div>
      </div>
    </div>
    <div class="timeline-bar-wrapper">
      {% for shot in result.shots %}
        {% set width_pct = ((shot.end_time - shot.start_time) / result.duration_seconds * 100) %}
        {% set primary_color = shot.dominant_colors[0] if shot.dominant_colors else '#333' %}
        <div class="timeline-segment" 
             style="width: {{ "%.2f"|format(width_pct) }}%; background-color: {{ primary_color }}; border-bottom: 4px solid var(--cut-{{ shot.cut_type }});"
             title="Shot {{ shot.index + 1 }}: {{ "%.1f"|format(shot.start_time) }}s - {{ "%.1f"|format(shot.end_time) }}s ({{ shot.cut_type }})">
          {% if width_pct > 4 %}
            <span class="timeline-segment-label">#{{ shot.index + 1 }}</span>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>

  <!-- Shot Breakdown Grid -->
  <div class="card-title" style="margin-bottom: 1rem;">
    <span class="card-title-icon">🎞</span> Shot Breakdown & Color Palettes
  </div>
  <div class="shots-grid">
    {% for shot in result.shots %}
      <div class="shot-card">
        <div class="shot-header">
          <span class="shot-number">Shot #{{ shot.index + 1 }}</span>
          <span class="cut-badge {{ shot.cut_type }}">{{ shot.cut_type }} ({{ "%.0f"|format(shot.cut_type_confidence * 100) }}%)</span>
        </div>
        <div class="shot-time">{{ "%.2f"|format(shot.start_time) }}s – {{ "%.2f"|format(shot.end_time) }}s ({{ "%.2f"|format(shot.end_time - shot.start_time) }}s)</div>
        <div class="palette-swatches">
          {% for color in shot.dominant_colors %}
            <div class="swatch" style="background-color: {{ color }};" title="{{ color }}"></div>
          {% endfor %}
        </div>
        {% if shot.possible_speed_ramp or shot.possible_stylized_rotoscope or shot.compositing_seam_flag %}
          <div class="motion-flags">
            {% if shot.possible_speed_ramp %}
              <span class="motion-badge ramp">possible speed ramp ({{ "%.0f"|format(shot.speed_ramp_confidence * 100) }}%)</span>
            {% endif %}
            {% if shot.possible_stylized_rotoscope %}
              <span class="motion-badge roto">possible stylized rotoscope ({{ "%.0f"|format(shot.stylized_rotoscope_confidence * 100) }}%)</span>
            {% endif %}
            {% if shot.compositing_seam_flag %}
              <span class="motion-badge seam">possible rough compositing seam</span>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  <!-- Transcript Section -->
  <div class="transcript-container">
    <div class="card-title" style="margin-bottom: 1rem;">
      <span class="card-title-icon">🎙</span> Audio Transcript
    </div>
    {% if result.transcript %}
      <div class="transcript-list">
        {% for seg in result.transcript %}
          <div class="transcript-item">
            <span class="transcript-time">{{ "%.1f"|format(seg.start_time) }}s - {{ "%.1f"|format(seg.end_time) }}s</span>
            <span class="transcript-text">{{ seg.text }}</span>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p class="summary-text" style="font-style: italic;">No speech detected in video audio track.</p>
    {% endif %}
  </div>

  <footer>
    Generated by Edit Analyzer &bull; {{ result.generated_at }}
  </footer>

</body>
</html>
