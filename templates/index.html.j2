<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Analyzer — Local Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-dark: #0F1117;
      --bg-card: #181B24;
      --bg-card-hover: #222634;
      --border-color: #2A2E3D;
      --text-main: #F0F3F9;
      --text-muted: #8E96A7;
      --text-dim: #5C6475;
      
      --accent-purple: #8B5CF6;
      --accent-blue: #3B82F6;
      --accent-pink: #EC4899;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      font-family: 'Inter', sans-serif;
      line-height: 1.6;
      padding: 2.5rem 1.5rem;
      max-width: 1200px;
      margin: 0 auto;
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2.5rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border-color);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    .brand-logo {
      width: 46px;
      height: 46px;
      background: linear-gradient(135deg, var(--accent-purple), var(--accent-pink));
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Outfit', sans-serif;
      font-weight: 700;
      font-size: 1.35rem;
      color: white;
      box-shadow: 0 4px 16px rgba(139, 92, 246, 0.4);
    }

    .brand-title h1 {
      font-family: 'Outfit', sans-serif;
      font-size: 1.6rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .brand-title p {
      font-size: 0.875rem;
      color: var(--text-muted);
    }

    /* Dropzone Upload */
    .upload-card {
      background: var(--bg-card);
      border: 2px dashed rgba(139, 92, 246, 0.35);
      border-radius: 20px;
      padding: 3rem 2rem;
      text-align: center;
      margin-bottom: 3rem;
      transition: all 0.25s ease;
      cursor: pointer;
      position: relative;
    }

    .upload-card:hover, .upload-card.dragover {
      border-color: var(--accent-purple);
      background: rgba(139, 92, 246, 0.05);
      transform: translateY(-2px);
    }

    .upload-icon {
      font-size: 3rem;
      margin-bottom: 1rem;
      display: block;
    }

    .upload-title {
      font-family: 'Outfit', sans-serif;
      font-size: 1.3rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
    }

    .upload-sub {
      color: var(--text-muted);
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
    }

    .btn-select {
      background: linear-gradient(135deg, var(--accent-purple), var(--accent-blue));
      color: white;
      font-family: 'Inter', sans-serif;
      font-weight: 600;
      font-size: 0.95rem;
      padding: 0.75rem 1.75rem;
      border-radius: 10px;
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(139, 92, 246, 0.3);
      transition: transform 0.15s, box-shadow 0.15s;
    }

    .btn-select:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 18px rgba(139, 92, 246, 0.45);
    }

    #file-input {
      display: none;
    }

    /* Progress Overlay */
    .progress-container {
      display: none;
      margin-top: 1.5rem;
      padding: 1.25rem;
      background: rgba(0,0,0,0.3);
      border-radius: 12px;
      border: 1px solid var(--border-color);
    }

    .spinner {
      width: 28px;
      height: 28px;
      border: 3px solid rgba(255,255,255,0.1);
      border-top-color: var(--accent-purple);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin: 0 auto 0.75rem auto;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .progress-status {
      font-size: 0.9rem;
      color: var(--text-main);
      font-weight: 500;
    }

    /* Jobs Browser */
    .section-title {
      font-family: 'Outfit', sans-serif;
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 1.25rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .jobs-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.25rem;
    }

    .job-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 1.35rem;
      transition: border-color 0.2s, transform 0.2s;
    }

    .job-card:hover {
      border-color: rgba(139, 92, 246, 0.4);
      transform: translateY(-2px);
    }

    .job-filename {
      font-family: 'Outfit', sans-serif;
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--text-main);
      margin-bottom: 0.4rem;
      word-break: break-all;
    }

    .job-meta {
      font-size: 0.825rem;
      color: var(--text-muted);
      margin-bottom: 1.25rem;
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .job-actions {
      display: flex;
      gap: 0.75rem;
    }

    .btn-action {
      flex: 1;
      text-align: center;
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 600;
      padding: 0.55rem 0.85rem;
      border-radius: 8px;
      transition: background 0.15s;
    }

    .btn-primary {
      background: rgba(139, 92, 246, 0.2);
      color: #A78BFA;
      border: 1px solid rgba(139, 92, 246, 0.4);
    }

    .btn-primary:hover {
      background: rgba(139, 92, 246, 0.35);
      color: white;
    }

    .btn-secondary {
      background: rgba(255,255,255,0.05);
      color: var(--text-muted);
      border: 1px solid var(--border-color);
    }

    .btn-secondary:hover {
      background: rgba(255,255,255,0.1);
      color: var(--text-main);
    }

    .no-jobs {
      grid-column: 1 / -1;
      text-align: center;
      padding: 3rem;
      background: var(--bg-card);
      border: 1px dashed var(--border-color);
      border-radius: 16px;
      color: var(--text-muted);
    }
  </style>
</head>
<body>

  <header>
    <div class="brand">
      <div class="brand-logo">EA</div>
      <div class="brand-title">
        <h1>Edit Analyzer</h1>
        <p>Local Video Research Dashboard</p>
      </div>
    </div>
  </header>

  <!-- Upload Dropzone -->
  <div class="upload-card" id="dropzone" onclick="document.getElementById('file-input').click()">
    <span class="upload-icon">📹</span>
    <div class="upload-title">Drop a video file here or click to browse</div>
    <div class="upload-sub">Supports .mp4, .mov, .avi, .mkv (processed locally)</div>
    <button type="button" class="btn-select">Select Video File</button>
    <input type="file" id="file-input" accept="video/*" onchange="handleFileSelect(event)">

    <div class="progress-container" id="progress-container">
      <div class="spinner"></div>
      <div class="progress-status" id="progress-status">Analyzing video cuts, color palette, and audio...</div>
    </div>
  </div>

  <!-- Past Jobs Browser -->
  <div class="section-title">
    <span>📂</span> Past Analyzed Reports ({{ jobs|length }})
  </div>

  <div class="jobs-grid">
    {% if jobs %}
      {% for job in jobs %}
        <div class="job-card">
          <div class="job-filename">{{ job.source_filename }}</div>
          <div class="job-meta">
            <span>⏱ {{ "%.1f"|format(job.duration_seconds) }}s</span>
            <span>🎞 {{ job.shots_count }} shots</span>
            <span>📅 {{ job.generated_at[:10] }}</span>
          </div>
          <div class="job-actions">
            <a href="/jobs/{{ job.job_id }}" class="btn-action btn-primary">View Report</a>
            <a href="/jobs/{{ job.job_id }}/json" target="_blank" class="btn-action btn-secondary">JSON</a>
          </div>
        </div>
      {% endfor %}
    {% else %}
      <div class="no-jobs">
        No past video analysis reports found. Drop a video file above to get started!
      </div>
    {% endif %}
  </div>

  <script>
    const dropzone = document.getElementById('dropzone');
    const fileInput = document.getElementById('file-input');
    const progressContainer = document.getElementById('progress-container');
    const progressStatus = document.getElementById('progress-status');

    ['dragenter', 'dragover'].forEach(eventName => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        dropzone.classList.add('dragover');
      }, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        dropzone.classList.remove('dragover');
      }, false);
    });

    dropzone.addEventListener('drop', (e) => {
      const files = e.dataTransfer.files;
      if (files.length > 0) {
        uploadFile(files[0]);
      }
    });

    function handleFileSelect(e) {
      if (e.target.files.length > 0) {
        uploadFile(e.target.files[0]);
      }
    }

    function uploadFile(file) {
      const formData = new FormData();
      formData.append('file', file);

      progressContainer.style.display = 'block';
      progressStatus.innerText = `Analyzing "${file.name}"... Please wait.`;

      fetch('/analyze', {
        method: 'POST',
        body: formData
      })
      .then(response => response.json())
      .then(data => {
        if (data.status === 'success' && data.report_url) {
          window.location.href = data.report_url;
        } else {
          alert('Error analyzing video: ' + (data.detail || 'Unknown error'));
          progressContainer.style.display = 'none';
        }
      })
      .catch(err => {
        alert('Analysis error: ' + err.message);
        progressContainer.style.display = 'none';
      });
    }
  </script>
</body>
</html>
